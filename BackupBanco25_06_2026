create table rodovias
(
    id          bigint generated by default as identity
        primary key,
    numrodovia  integer,
    tiporodovia varchar(255),
    vmd         integer
);

alter table rodovias
    owner to postgres;

create table cadastroseguimento
(
    id                 bigint generated by default as identity
        primary key,
    cidade             varchar(255),
    datacadastro       timestamp(6),
    extensaoseguimento double precision,
    numseguimento      integer,
    seguimentofinal    double precision,
    seguimentoinicial  double precision,
    rodovia_id         bigint
        constraint fkpk7rky3n5cgcq00gm645tjurl
            references rodovias
);

alter table cadastroseguimento
    owner to postgres;

create table defeitospavimentos
(
    codigo        varchar(255) not null
        primary key,
    numseguimento varchar(255),
    tipodefeito   varchar(255),
    rodovia_id    bigint
        constraint fkiwn7huoswunw5exg0brlanaqg
            references rodovias
);

alter table defeitospavimentos
    owner to postgres;

create table defeitosseguimentos
(
    defeitospavimentos_codigo varchar(255) not null
        constraint fk29knlgbm03gp59if6qs37imnv
            references defeitospavimentos,
    cadastroseguimento_id     bigint       not null
        constraint fk9op30lo80s5dkqvr3c9plm296
            references cadastroseguimento
);

alter table defeitosseguimentos
    owner to postgres;

